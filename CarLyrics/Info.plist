<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- ───── Standard Xcode keys ───── -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleDisplayName</key>
    <string>CarLyrics</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>

    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>

    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- ───── Custom URL Scheme (Spotify Callback) ───── -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.carlyrics.spotify</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>carlyrics</string>
            </array>
        </dict>
    </array>

    <!-- ───── Live Activities ───── -->
    <!--
        Required for ActivityKit / Live Activities.
        Also add the "Supports Live Activities" capability toggle in Xcode.
    -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>

    <!-- ───── Media Library ───── -->
    <!--
        Required to read NowPlayingItem from MPMusicPlayerController.
    -->
    <key>NSAppleMusicUsageDescription</key>
    <string>CarLyrics reads the currently playing song to display synchronized lyrics.</string>

    <!-- ───── CoreMotion ───── -->
    <!--
        Required for CMMotionManager (G-force telemetry).
    -->
    <key>NSMotionUsageDescription</key>
    <string>CarLyrics reads motion data to display real-time G-force telemetry during your drive.</string>

    <!-- ───── Bluetooth (OBD-II Dongle) ───── -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>CarLyrics benoetigt Bluetooth, um Live-Motordaten von deinem OBD-II-Adapter (ELM327) auszulesen.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>CarLyrics verbindet sich mit deinem OBD-II-Adapter fuer Live-Telemetrie.</string>

    <!-- ───── Background Modes ───── -->
    <!--
        "audio"          – keeps the app alive to read currentPlaybackTime
        "fetch"          – (optional) background refresh for pre-fetching lyrics
        "processing"     – (optional) for heavy LRC processing tasks
    -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>bluetooth-central</string>
        <string>fetch</string>
    </array>

    <!-- ───── Scene / UI ───── -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict/>
    </dict>

    <key>UILaunchScreen</key>
    <dict/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

</dict>
</plist>
